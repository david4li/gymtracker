# Base project URL. Must NOT include /rest/v1.
SUPABASE_URL=https://uhqsokzxdsrkuyepyqhc.supabase.co

# Publishable key only. The secret key must NEVER be set here — the API relies
# on row-level security via the caller's JWT, which bypassrls would defeat.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Render injects PORT in production; 4000 is the local default.
PORT=4000

# Comma-separated browser origins allowed to call this API. Usually empty,
# since the Next.js server calls it server-to-server.
ALLOWED_ORIGINS=
